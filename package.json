{
  "name": "blueprint-sync",
  "version": "0.1.0",
  "description": "Offline PDF annotation and LAN sync for architectural drawings",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "svelte-kit sync && vite dev",
    "build": "node scripts/windowsArm64Build.mjs",
    "build:linux:usb": "node scripts/linuxUsbBuild.mjs",
    "build:web": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "svelte-sonner": "^1.2.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
